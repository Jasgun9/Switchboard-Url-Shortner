[Unit]
Description=Switchboard Celery worker
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=jasgun
Group=jasgun
WorkingDirectory=/var/www/switchboard/backend
EnvironmentFile=/var/www/switchboard/backend/.env
ExecStart=/var/www/switchboard/backend/.venv/bin/celery -A config worker \
    --loglevel=INFO \
    --concurrency=2 \
    --max-tasks-per-child=500
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/switchboard/backend

[Install]
WantedBy=multi-user.target
