[Unit]
Description=URL shortener Celery worker
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=switchboard
Group=switchboard
WorkingDirectory=/srv/switchboard/backend
EnvironmentFile=/srv/switchboard/backend/.env
ExecStart=/srv/switchboard/backend/.venv/bin/celery -A config worker \
    --loglevel=INFO \
    --concurrency=2 \
    --max-tasks-per-child=500
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/switchboard/backend

[Install]
WantedBy=multi-user.target
