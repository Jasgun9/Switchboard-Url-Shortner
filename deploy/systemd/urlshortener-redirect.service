[Unit]
Description=URL shortener redirect service (Gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=urlshortener
Group=urlshortener
WorkingDirectory=/srv/urlshortener/backend
EnvironmentFile=/srv/urlshortener/backend/.env
Environment=DJANGO_ROOT_URLCONF=config.urls_redirect
# The redirect path is short and cache-backed, so more workers with a tight
# timeout is the right shape here.
ExecStart=/srv/urlshortener/backend/.venv/bin/gunicorn config.wsgi_redirect:application \
    --bind unix:/run/urlshortener/redirect.sock \
    --workers 4 \
    --timeout 15 \
    --graceful-timeout 15 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=urlshortener
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/urlshortener/backend

[Install]
WantedBy=multi-user.target
