[Unit]
Description=Switchboard redirect service (Gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=jasgun
Group=jasgun
WorkingDirectory=/var/www/switchboard/backend
EnvironmentFile=/var/www/switchboard/backend/.env
Environment=DJANGO_ROOT_URLCONF=config.urls_redirect
# The redirect path is short and cache-backed, so more workers with a tight
# timeout is the right shape here.
ExecStart=/var/www/switchboard/backend/.venv/bin/gunicorn config.wsgi_redirect:application \
    --bind unix:/run/switchboard/redirect.sock \
    --workers 4 \
    --timeout 15 \
    --graceful-timeout 15 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=switchboard
# Both gunicorn units keep their socket in /run/switchboard. Without this,
# stopping either one deletes the directory out from under the other.
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/switchboard/backend

[Install]
WantedBy=multi-user.target
