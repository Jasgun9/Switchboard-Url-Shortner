[Unit]
Description=URL shortener web application (Gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=switchboard
Group=switchboard
WorkingDirectory=/srv/switchboard/backend
EnvironmentFile=/srv/switchboard/backend/.env
Environment=DJANGO_ROOT_URLCONF=config.urls_web
ExecStart=/srv/switchboard/backend/.venv/bin/gunicorn config.wsgi_web:application \
    --bind unix:/run/switchboard/web.sock \
    --workers 3 \
    --timeout 30 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
RuntimeDirectory=switchboard
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/switchboard/backend

[Install]
WantedBy=multi-user.target
