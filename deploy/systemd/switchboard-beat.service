[Unit]
Description=Switchboard Celery beat scheduler
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=jasgun
Group=jasgun
WorkingDirectory=/var/www/switchboard/backend
EnvironmentFile=/var/www/switchboard/backend/.env
# Only ever run one beat process, otherwise the nightly jobs fire twice.
ExecStart=/var/www/switchboard/backend/.venv/bin/celery -A config beat \
    --loglevel=INFO \
    --schedule=/var/lib/switchboard/celerybeat-schedule
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=switchboard
ReadWritePaths=/var/www/switchboard/backend /var/lib/switchboard

[Install]
WantedBy=multi-user.target
