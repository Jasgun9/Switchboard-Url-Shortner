[Unit]
Description=URL shortener Celery beat scheduler
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=switchboard
Group=switchboard
WorkingDirectory=/srv/switchboard/backend
EnvironmentFile=/srv/switchboard/backend/.env
# Only ever run one beat process, otherwise the nightly jobs fire twice.
ExecStart=/srv/switchboard/backend/.venv/bin/celery -A config beat \
    --loglevel=INFO \
    --schedule=/var/lib/switchboard/celerybeat-schedule
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=switchboard
ReadWritePaths=/srv/switchboard/backend /var/lib/switchboard

[Install]
WantedBy=multi-user.target
