# Copy to backend/.env and fill in. Never commit the real file.

DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_DEBUG=0
ALLOWED_HOSTS=urlshortner.jasgun.me,xyz.jasgun.me
CSRF_TRUSTED_ORIGINS=https://urlshortner.jasgun.me

# sqlite:///path/to/db.sqlite3 for local development
DATABASE_URL=postgres://urlshortener:password@127.0.0.1:5432/urlshortener
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Public origins of the two deployables.
SHORT_DOMAIN=https://xyz.jasgun.me
WEB_DOMAIN=https://urlshortner.jasgun.me

# Behind Cloudflare this is the only header that carries a real client IP.
CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP

# MaxMind GeoLite2-City.mmdb. Leave empty to disable geographic analytics.
GEOIP_PATH=/var/lib/geoip/GeoLite2-City.mmdb

# Salt for the one-way IP digests stored on click events. Changing it makes
# historic unique-visitor counts discontinuous.
IP_HASH_SALT=change-me-too

SHORT_CODE_LENGTH=7
RESOLVE_CACHE_TTL=300
CLICK_RETENTION_DAYS=180
LOG_LEVEL=INFO

# "requests,seconds"
RATE_LIMIT_ANON_CREATE=10,3600
RATE_LIMIT_USER_CREATE=120,3600
RATE_LIMIT_LOGIN=10,900
RATE_LIMIT_REGISTER=5,3600
RATE_LIMIT_LINK_PASSWORD=8,900
RATE_LIMIT_API=1000,3600
RATE_LIMIT_REDIRECT=600,60
